#### Верхний уровень (файлы выше этой директории игнорируются)
root = true


#### Общие настройки для всех файлов
[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
tab_width = 4
dotnet_style_operator_placement_when_wrapping = beginning_of_line
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_auto_properties = true:silent
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_namespace_match_folder = true:suggestion


#### Настройки для C# файлов
[*.cs]

indent_style = space
indent_size = 4
csharp_indent_labels = one_less_than_current

#### Именование: классы в PascalCase
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_symbols.classes.applicable_kinds = class, struct, interface, enum
dotnet_naming_symbols.classes.applicable_accessibilities = *

dotnet_naming_rule.classes_should_be_pascal_case.severity = error
dotnet_naming_rule.classes_should_be_pascal_case.symbols = classes
dotnet_naming_rule.classes_should_be_pascal_case.style = pascal_case

#### Именование: параметры в camelCase
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.parameters.applicable_accessibilities = *

dotnet_naming_rule.parameters_should_be_camel_case.severity = warning
dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameters
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_case

#### Именование: приватные поля с префиксом _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = underscore_camel_case

#### Обязательное использование this. для полей
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

#### Предпочитать var
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

#### Предпочитать expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

#### Использовать file-scoped namespace
csharp_style_namespace_declarations = file_scoped:suggestion

#### StyleCop (SA****)

#### Отключаем проблемные правила
dotnet_diagnostic.SA0001.severity = none      # XML comment analysis disabled (не мешает)
dotnet_diagnostic.SA1101.severity = none      # this. перед членами (не обязателен)
dotnet_diagnostic.SA1200.severity = none      # using внутри namespace
dotnet_diagnostic.SA1309.severity = none      # поля с _
dotnet_diagnostic.SA1600.severity = none      # требование XML-комментариев ко всем элементам
dotnet_diagnostic.SA1633.severity = none      # заголовок файла
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1516.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.ASP0018.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.S6966.severity = none
dotnet_diagnostic.S6964.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1000.severity = none
dotnet_diagnostic.SA1614.severity = none

#### Оставляем включёнными важные правил
dotnet_diagnostic.SA1001.severity = warning   # Запятые
dotnet_diagnostic.SA1009.severity = warning   # Операторы с пробелами
dotnet_diagnostic.SA1010.severity = none   # Пробел перед [
dotnet_diagnostic.SA1011.severity = warning   # Пробелы в скобках

dotnet_diagnostic.SA1201.severity = warning   # Порядок элементов в классе
dotnet_diagnostic.SA1202.severity = warning   # Порядок модификаторов доступа
dotnet_diagnostic.SA1204.severity = warning   # using отсортированы

dotnet_diagnostic.SA1500.severity = warning   # Скобки на новой строке
dotnet_diagnostic.SA1503.severity = warning   # Без пустых строк для отступов
dotnet_diagnostic.SA1513.severity = warning   # Закрывающие скобки на новой строке

#### Встроенные анализаторы .NET (CA****) 
dotnet_analyzer_diagnostic.category-Performance.severity = suggestion
dotnet_analyzer_diagnostic.category-Reliability.severity = suggestion
dotnet_analyzer_diagnostic.category-Security.severity = suggestion
dotnet_analyzer_diagnostic.category-Maintainability.severity = suggestion
dotnet_analyzer_diagnostic.category-Design.severity = suggestion
dotnet_analyzer_diagnostic.category-Usage.severity = suggestion
dotnet_analyzer_diagnostic.category-Naming.severity = suggestion

#### Точечно отключаем самые надоедливые CA-правила
dotnet_diagnostic.CA1002.severity = none      # List<T> в публичном API
dotnet_diagnostic.CA2227.severity = none      # set для коллекций
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait (не нужен в ASP.NET Core)
dotnet_diagnostic.CA1860.severity = none      # Count vs Any()
dotnet_diagnostic.CA1062.severity = none      # Проверка null для параметров
dotnet_diagnostic.CA1303.severity = none      # Локализация строк
dotnet_diagnostic.CA1707.severity = none      # Подчёркивания в именах
dotnet_diagnostic.CA1819.severity = none      # Свойства только для чтения

#### SonarAnalyzer (S****)
dotnet_diagnostic.S107.severity = suggestion       # Длина методов
dotnet_diagnostic.S138.severity = none             # Количество строк в методе
dotnet_diagnostic.S1200.severity = none            # Закомментированный код

#### Оставляем включенными важные правила
dotnet_diagnostic.S1125.severity = warning         # Избыточные булевы литералы
dotnet_diagnostic.S1186.severity = warning         # Пустые методы
dotnet_diagnostic.S1481.severity = warning         # Неиспользуемые переменные
dotnet_diagnostic.S2583.severity = warning         # Условие всегда true/false
dotnet_diagnostic.S2589.severity = warning         # Условие всегда true/false
dotnet_diagnostic.S3168.severity = warning         # Async void методы
dotnet_diagnostic.S3881.severity = warning         # IDisposable
